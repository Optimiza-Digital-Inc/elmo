meta {
  name: competitors and prompts may omit their lists
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/api/v1/brands
  body: json
  auth: inherit
}

script:pre-request {
  bru.setVar("listsBrandId", "e2e-omitted-lists-" + Date.now());
}

body:json {
  {
    "id": "{{listsBrandId}}",
    "name": "Omitted Lists Brand",
    "profileLinks": ["https://instagram.com/example-brand"],
    "competitors": [{ "name": "Bare Competitor", "profileLinks": ["https://instagram.com/example-competitor"] }],
    "prompts": [{ "value": "Which tools does a bare prompt compare?" }]
  }
}

assert {
  res.status: eq 201
  res.body.id: eq {{listsBrandId}}
  res.body.domains: length 0
}

tests {
  test("profile links keep the full URL", function() {
    expect(res.getBody().profileLinks).to.deep.equal(["https://instagram.com/example-brand"]);
  });
}
